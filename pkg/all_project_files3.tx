syntax = "proto3";

package deposit.v1;

option go_package = "github.com/alihojaty/reliable-deposit-processor/pkg/pb/deposit/v1;depositv1";

import "google/protobuf/timestamp.proto";

service DepositPublisherService {
  rpc PublishDeposit(PublishDepositRequest) returns (PublishDepositResponse);
}

message PublishDepositRequest {
  string event_id = 1;
  int64 user_id = 2;
  string currency = 3;
  string amount = 4;
  google.protobuf.Timestamp created_at = 5;
}

message PublishDepositResponse {
  uint64 stream_sequence = 1;
  bool duplicate = 2;
